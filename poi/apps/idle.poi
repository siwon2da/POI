                              relief: "flat", font: ui, borderwidth: 0, cursor: "hand2")
W.haon_attach_btn.pack(side: "left")
W.haon_fix = tk.Button(W.haon_actions, text: "🔧 오류 자동수정", command: 하온고치기,
                       bg: T.bg2, fg: T.ink2, relief: "flat", font: ui,
                       borderwidth: 0, cursor: "hand2")
W.haon_fix.pack(side: "left", padx: 8)
W.haon_gpt = tk.Button(W.haon_actions, text: "GPT 로그인", command: 하온로그인,
                       bg: T.bg2, fg: T.blue, relief: "flat", font: ui,
                       borderwidth: 0, cursor: "hand2")
W.haon_gpt.pack(side: "left")
W.haon_llm = tk.Button(W.haon_actions, text: "⬇ 로컬 LLM", command: 하온설치,
                       bg: T.bg2, fg: T.ink2, relief: "flat", font: ui,
                       borderwidth: 0, cursor: "hand2")
W.haon_llm.pack(side: "left", padx: 8)

W.haon_inwrap = tk.Frame(W.haon_frame, bg: T.bg)
W.haon_in = tk.Text(W.haon_inwrap, font: ui, relief: "flat", bg: T.bg, fg: T.ink,
                    insertbackground: T.blue, height: 3, width: 1, wrap: "word",
                    padx: 8, pady: 6, highlightthickness: 1,
                    highlightbackground: T.line, highlightcolor: T.blue)
W.haon_send = tk.Button(W.haon_inwrap, text: "보내기", command: 하온묻기,
                        bg: T.blue, fg: "#ffffff", relief: "flat", font: ui,
                        borderwidth: 0, cursor: "hand2", padx: 14)
W.haon_send.pack(side: "right", fill: "y", padx: 4, pady: 2)
W.haon_in.pack(side: "left", fill: "both", expand: true)
W.haon_in.bind("<Return>", 하온보내기키)
W.haon_in.bind("<Shift-Return>", (e) => null)

# 순서 중요 — 아래에서부터 고정: 입력칸 → 버튼줄 → (남는 공간) 대화 로그
W.haon_inwrap.pack(side: "bottom", fill: "x", padx: 8, pady: 8)
W.haon_actions.pack(side: "bottom", fill: "x", padx: 8, pady: 2)
W.haon_log.pack(side: "top", fill: "both", expand: true, padx: 8, pady: 8)
하온시스템("무엇이든 물어보세요. Enter 로 보내고, Shift+Enter 로 줄바꿈. 오류는 '오류 자동수정' 이 실제 컴파일러로 고칩니다.")

W.console = tk.Frame(W.root, bg: T.console)
W.console.pack(side: "top", fill: "both")
W.out_label = tk.Label(W.console, text: "  출력 · 콘솔", bg: T.console, fg: T.ink3,
                       font: ui, anchor: "w")
W.out_label.pack(side: "top", fill: "x", pady: 3)
W.out = tk.Text(W.console, height: 12, wrap: "word", font: 글꼴,
                bg: T.console, fg: T.consink, relief: "flat",
                padx: 16, pady: 10, state: "disabled")
W.out.pack(side: "top", fill: "both")
W.out.tag_configure("octo", foreground: T.octo)

W.status = tk.Label(W.root, text: "  준비됨        POI {버전}", bg: T.bg2,
                    fg: T.ink2, font: ui, anchor: "w")
W.status.pack(side: "bottom", fill: "x")

W.editor.bind("<<Modified>>", 편집됨)
W.editor.bind("<KeyRelease>", 커서이동, add: "+")
W.editor.bind("<ButtonRelease-1>", 커서이동)
W.root.bind("<F5>", (e) => 실행())
W.root.bind("<Control-s>", (e) => 저장())
W.root.bind("<Control-Shift-S>", (e) => 다른이름저장())
W.root.bind("<Control-n>", (e) => 새파일())
W.root.bind("<Control-o>", (e) => 열기())
W.root.bind("<Control-r>", (e) => 터미널실행())
W.root.bind("<Control-P>", (e) => 팔레트())
W.root.bind("<Control-Shift-P>", (e) => 팔레트())
W.root.bind("<Control-j>", (e) => 하온토글())

열대상 = _open_target()
if 열대상
    파일열기(열대상)
else
    예제넣기()
커서이동(null)
W.editor.focus_set()
W.root.after(120, 스플래시)
W.root.after(250, 하온펌프)

# 자체 점검 — POI_IDLE_SELFTEST=1 이면 창을 실제로 띄워 하온 채팅 입력칸 크기를 재고 종료
fn 자체점검()
    하온토글()
    W.root.update()
    W.root.update_idletasks()
    show "  frame  {W.haon_frame.winfo_width()}x{W.haon_frame.winfo_height()} map={W.haon_frame.winfo_ismapped()}"
    show "  log    {W.haon_log.winfo_width()}x{W.haon_log.winfo_height()} map={W.haon_log.winfo_ismapped()}"
    show "  inwrap {W.haon_inwrap.winfo_width()}x{W.haon_inwrap.winfo_height()} map={W.haon_inwrap.winfo_ismapped()}"
    show "  input  {W.haon_in.winfo_width()}x{W.haon_in.winfo_height()} map={W.haon_in.winfo_ismapped()}"
    show "  send   {W.haon_send.winfo_width()}x{W.haon_send.winfo_height()} map={W.haon_send.winfo_ismapped()}"
    입력높이 = W.haon_in.winfo_height()
    입력너비 = W.haon_in.winfo_width()
    바라벨 = []
    for 자 in W.bar.winfo_children()
        if 자.winfo_class() == "Button"
            바라벨.add(자.cget("text"))
    난독버튼 = false
    디컴버튼 = false
    for 라 in 바라벨
        if 라.contains("난독화")
            난독버튼 = true
        if 라.contains("디컴파일")
            디컴버튼 = true
    show "  toolbar 난독화={난독버튼} 디컴파일={디컴버튼}"
    ok = W.haon_in.winfo_ismapped() and W.haon_send.winfo_ismapped() and 입력높이 >= 40 and 입력너비 >= 150 and 난독버튼 and 디컴버튼
    상태 = "PASS"
    if not ok
        상태 = "FAIL"
    show "SELFTEST {상태}"
    W.root.destroy()

fn 자체점검_난독()
    대상 = system.env("POI_IDLE_OBF_FILE") or "examples/basics.poi"
    S.file = 대상
    S.dirty = false
    난독화보기()
    W.root.after(4500, _난독결과)

fn _난독결과()
    본문 = W.out.get("1.0", "end")
    포장됨 = 본문.contains("import base64") and (본문.contains("_m.loads") or 본문.contains("marshal"))
    실패없음 = not 본문.contains("난독화 실패")
    show "  OBF console chars: {len(본문)}"
    show "  포장됨={포장됨}  실패없음={실패없음}"
    상태 = "PASS"
    if not (포장됨 and 실패없음 and len(본문) > 300)
        상태 = "FAIL"
    show "OBFTEST {상태}"
    W.root.destroy()

if system.env("POI_IDLE_SELFTEST") == "1"
    W.root.after(700, 자체점검)
else if system.env("POI_IDLE_SELFTEST") == "obf"
    W.root.after(500, 자체점검_난독)

W.root.mainloop()
