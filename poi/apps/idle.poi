                      font: ui, anchor: "w", wraplength: 360, justify: "left")
W.haon_sub.pack(side: "top", fill: "x", padx: 12)

# 위젯을 만들고 — 입력칸·버튼줄을 '아래'에 먼저 고정한 뒤 대화 로그가 남은 공간을 채운다.
