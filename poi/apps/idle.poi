# ┌─────────────────────────────────────────────────────────────────┐
# │  POI IDLE  —  POI 로 작성한 코드 편집기                          │
# │  실행:  poi idle [파일.poi]      빌드:  poi build --app idle     │
# │  이 파일 자체가 POI 프로그램입니다 (tkinter 위에서).            │
# └─────────────────────────────────────────────────────────────────┘

use py:tkinter as tk
use py:tkinter.font as tkfont
use py:tkinter.filedialog as fd
use py:tkinter.messagebox as mb
use py:tkinter.simpledialog as sd

# ── 실행 엔진 · 문법 강조 · 편집 편의기능 (파이썬 상호운용) ───────────
python {
    import io, re, os, sys, json, queue, threading, contextlib, ctypes, traceback, subprocess

    _KW = ("show|ask|use|python|try|catch|if|else|elif|for|in|while|repeat|"
           "fn|return|end|match|when|is|between|and|or|not|as|const|let|"
           "server|webapp|page|state|action|app|window|raise|assert|test|true|false|null")
    _KW_RE  = re.compile(r"(?<![\w.])(" + _KW + r")(?![\w])")
    _STR_RE = re.compile(r'"(?:[^"\\]|\\.)*"')
    _COM_RE = re.compile(r"#[^\n]*")
    _NUM_RE = re.compile(r"(?<![\w.])\d+(?:\.\d+)?")
    _FN_RE  = re.compile(r"(?<=\bfn\s)([A-Za-z_가-힣][\w가-힣]*)")

    def _highlight(txt):
        for tag in ("kw", "str", "com", "num", "fn"):
            txt.tag_remove(tag, "1.0", "end")
        body = txt.get("1.0", "end-1c")
        for tag, rx in (("str", _STR_RE), ("com", _COM_RE),
                        ("kw", _KW_RE), ("num", _NUM_RE), ("fn", _FN_RE)):
            for m in rx.finditer(body):
                txt.tag_add(tag, "1.0+%dc" % m.start(), "1.0+%dc" % m.end())

    # ── 실행 (별도 스레드 + 타임아웃) ──────────────────────────────
    _Q = queue.Queue()
    _worker = {"tid": None}

    def _kill_worker():
        tid = _worker.get("tid")
        if tid:
            ctypes.pythonapi.PyThreadState_SetAsyncExc(
                ctypes.c_long(tid), ctypes.py_object(KeyboardInterrupt))

    def _drain():
        out = []
        try:
            while True:
                out.append(_Q.get_nowait())
        except queue.Empty:
            pass
        return out

    def _run_poi(src, base_dir):
        from poi.interpreter import compile_source
        from poi.runtime import make_globals

        class _Pipe(io.TextIOBase):
            def write(self, s):
                if s:
                    _Q.put(s)
                return len(s)

        def job():
            _worker["tid"] = threading.get_ident()
            g = make_globals()
            g["__name__"] = "__main__"
            g["__poi_dir__"] = base_dir or os.getcwd()
            code = None
            try:
                py, _lm, cn = compile_source(src, "<idle>")
                code = compile(py, cn, "exec")
            except Exception as e:
                _Q.put(getattr(e, "render", lambda _s: str(e))(src) + "\n")
            if code is not None:
                cwd0 = os.getcwd()
                try:
                    if base_dir and os.path.isdir(base_dir):
                        os.chdir(base_dir)
                    with contextlib.redirect_stdout(_Pipe()), \
                         contextlib.redirect_stderr(_Pipe()):
                        exec(code, g)
                except SystemExit:
                    pass
                except KeyboardInterrupt:
                    _Q.put("\n[중단됨 — 실행이 너무 오래 걸렸어요]\n")
                except Exception as e:
                    from poi.errors import translate_exception
                    try:
                        _Q.put("\n" + translate_exception(e, src, {}, "<idle>").render(src) + "\n")
                    except Exception:
                        _Q.put("\n" + traceback.format_exc() + "\n")
                finally:
                    os.chdir(cwd0)
            _worker["tid"] = None
            _Q.put("<<<idle-done>>>")

        threading.Thread(target=job, daemon=True).start()

    # ── 터미널에서 실행 (진짜 콘솔 창) ────────────────────────────
    def _poi_launcher():
        if getattr(sys, "frozen", False):
            cand = os.path.join(os.path.dirname(sys.executable), "poi.exe")
            if os.path.isfile(cand):
                return [cand]
        return [sys.executable, "-m", "poi"]

    def _run_terminal(path, base_dir):
        argv = _poi_launcher() + ["run", path]
        try:
            if os.name == "nt":
                subprocess.Popen(["cmd", "/c", "start", "POI",
                                  "cmd", "/k"] + argv, cwd=base_dir or None)
            else:
                subprocess.Popen(argv, cwd=base_dir or None)
            return True
        except Exception as e:
            _Q.put("터미널 실행 실패: %s\n" % e)
            return False

    # ── 최근 파일 ────────────────────────────────────────────────
    _RECENT = os.path.join(os.path.expanduser("~"), ".poi", "idle_recent.json")

    def _recent_load():
        try:
            with open(_RECENT, encoding="utf-8") as f:
                return [p for p in json.load(f) if os.path.isfile(p)]
        except Exception:
            return []

    def _recent_add(path):
        if not path:
            return
        items = [path] + [p for p in _recent_load() if p != path]
        items = items[:8]
        try:
            os.makedirs(os.path.dirname(_RECENT), exist_ok=True)
            with open(_RECENT, "w", encoding="utf-8") as f:
                json.dump(items, f, ensure_ascii=False)
        except Exception:
            pass

    def _open_target():
        p = os.environ.get("POI_IDLE_OPEN", "")
        return p if p and os.path.isfile(p) else ""

    # ── 에디터 편의기능 (자동 들여쓰기 · 괄호 · 주석 · 확대) ────────
    _PAIRS = {"(": ")", "[": "]", "{": "}", '"': '"'}

    def _wire_editor(txt, font, run_cb):
        def on_return(e):
            line = txt.get("insert linestart", "insert")
            indent = re.match(r"[ \t]*", line).group(0)
            stripped = line.strip()
            if stripped.endswith(("{", ":")) or re.match(
                    r"(fn|if|else|elif|for|while|repeat|try|catch|match|when|"
                    r"server|webapp|page|state|action|app|window)\b", stripped):
                indent += "    "
            txt.insert("insert", "\n" + indent)
            txt.see("insert")
            return "break"

        def on_pair(e):
            ch = e.char
            close = _PAIRS[ch]
            try:
                sel = txt.get("sel.first", "sel.last")
                txt.delete("sel.first", "sel.last")
                txt.insert("insert", ch + sel + close)
            except tk.TclError:
                nxt = txt.get("insert", "insert+1c")
                if ch == '"' and nxt == '"':
                    txt.mark_set("insert", "insert+1c")
                    return "break"
                txt.insert("insert", ch + close)
                txt.mark_set("insert", "insert-1c")
            return "break"

        def indent_sel(e):
            try:
                a = int(txt.index("sel.first").split(".")[0])
                b = int(txt.index("sel.last").split(".")[0])
            except tk.TclError:
                txt.insert("insert", "    ")
                return "break"
            for ln in range(a, b + 1):
                txt.insert("%d.0" % ln, "    ")
            return "break"

        def dedent_sel(e):
            try:
                a = int(txt.index("sel.first").split(".")[0])
                b = int(txt.index("sel.last").split(".")[0])
            except tk.TclError:
                a = b = int(txt.index("insert").split(".")[0])
            for ln in range(a, b + 1):
                head = txt.get("%d.0" % ln, "%d.4" % ln)
                cut = len(head) - len(head.lstrip(" "))
                if cut:
                    txt.delete("%d.0" % ln, "%d.%d" % (ln, min(cut, 4)))
            return "break"

        def toggle_comment(e):
            try:
                a = int(txt.index("sel.first").split(".")[0])
                b = int(txt.index("sel.last").split(".")[0])
            except tk.TclError:
                a = b = int(txt.index("insert").split(".")[0])
            lines = [txt.get("%d.0" % ln, "%d.end" % ln) for ln in range(a, b + 1)]
            on = all((not s.strip()) or s.lstrip().startswith("# ") for s in lines)
            for i, ln in enumerate(range(a, b + 1)):
                s = lines[i]
                if not s.strip():
                    continue
                if on:
                    idx = s.index("# ")
                    txt.delete("%d.%d" % (ln, idx), "%d.%d" % (ln, idx + 2))
                else:
                    txt.insert("%d.0" % ln, "# ")
            return "break"

        def zoom(delta):
            def _f(e=None):
                sz = max(8, min(40, int(font.cget("size")) + delta))
                font.configure(size=sz)
                return "break"
            return _f

        def dup_line(e):
            s = txt.get("insert linestart", "insert lineend")
            txt.insert("insert lineend", "\n" + s)
            return "break"

        def find(e=None):
            q = sd.askstring("찾기", "찾을 내용:", parent=txt.winfo_toplevel())
            if not q:
                return "break"
            txt.tag_remove("find", "1.0", "end")
            start = "insert"
            pos = txt.search(q, start, stopindex="end", nocase=True)
            if not pos:
                pos = txt.search(q, "1.0", stopindex="end", nocase=True)
            if pos:
                end = "%s+%dc" % (pos, len(q))
                txt.tag_add("find", pos, end)
                txt.tag_configure("find", background="#3d5a80", foreground="#fff")
                txt.mark_set("insert", end)
                txt.see(pos)
            return "break"

        for ch in _PAIRS:
            txt.bind(ch, on_pair)
        txt.bind("<Return>", on_return)
        txt.bind("<Tab>", indent_sel)
        txt.bind("<Shift-Tab>", dedent_sel)
        txt.bind("<ISO_Left_Tab>", dedent_sel)
        txt.bind("<Control-slash>", toggle_comment)
        txt.bind("<Control-d>", dup_line)
        txt.bind("<Control-f>", find)
        txt.bind("<Control-equal>", zoom(1))
        txt.bind("<Control-plus>", zoom(1))
        txt.bind("<Control-minus>", zoom(-1))
        txt.bind("<Control-0>", lambda e: (font.configure(size=12), "break")[1])

    # ── 줄번호 여백 ──────────────────────────────────────────────
    def _make_gutter(parent, txt, font):
        g = tk.Text(parent, width=5, padx=8, takefocus=0, border=0,
                    bg="#0b0d10", fg="#4a525e", font=font, state="disabled",
                    cursor="arrow", spacing1=2, spacing3=2)

        def refresh(e=None):
            n = int(txt.index("end-1c").split(".")[0])
            g.config(state="normal")
            g.delete("1.0", "end")
            g.insert("1.0", "\n".join("%4d" % i for i in range(1, n + 1)))
            g.config(state="disabled")
            g.yview_moveto(txt.yview()[0])

        txt.bind("<KeyRelease>", refresh, add="+")
        txt.bind("<MouseWheel>", lambda e: txt.after(1, refresh), add="+")
        txt.bind("<Configure>", refresh, add="+")
        parent.after(60, refresh)
        return g, refresh

    SAMPLE = (
        '# POI 에 오신 걸 환영해요. F5 를 누르면 실행됩니다.\n\n'
        'show "안녕하세요, POI!"\n\n'
        'fn 인사(이름)\n'
        '    return "반가워요 {이름}님"\n\n'
        'for 사람 in ["시원", "민수", "지연"]\n'
        '    show 인사(사람)\n\n'
        '합 = 0\n'
        'repeat 10 as i\n'
        '    합 = 합 + i\n'
        'show "0~9 합계는 {합}"\n'
    )
}

# ── 상태 · 위젯 보관함 (POI 함수는 전역 재대입을 안 하므로 Box 로) ────
S = { file: null, dirty: false, running: false }
W = {}
버전 = system.poi_version()

fn 현재폴더()
    if S.file != null
        return path.dir(S.file)
    return system.cwd()

# ── 동작 ────────────────────────────────────────────────────────────
fn 제목갱신()
    이름 = "이름 없음"
    if S.file != null
        이름 = path.base(S.file)
    표시 = ""
    if S.dirty
        표시 = " ●"
    W.root.title("POI IDLE  —  {이름}{표시}")

fn 본문()
    return W.editor.get("1.0", "end-1c")

fn 본문설정(글)
    W.editor.delete("1.0", "end")
    W.editor.insert("1.0", 글)
    _highlight(W.editor)
    W.editor.edit_modified(false)
    W.gutter_refresh(null)

fn 새파일()
    if S.dirty and not mb.askokcancel("새 파일", "저장하지 않은 변경이 있어요. 계속할까요?")
        return
    S.file = null
    S.dirty = false
    본문설정("")
    제목갱신()
    로그("새 파일을 만들었어요.")

fn 파일열기(경로)
    try
        본문설정(file.read(경로))
        S.file = 경로
        S.dirty = false
        _recent_add(경로)
        제목갱신()
        로그("열었어요:  {경로}")
    catch e
        mb.showerror("열기 실패", "{e}")

fn 열기()
    경로 = fd.askopenfilename(filetypes: [["POI 파일", "*.poi"], ["모든 파일", "*.*"]])
    if 경로
        파일열기(경로)

fn 최근()
    목록 = _recent_load()
    if not 목록
        로그("최근 연 파일이 없어요.")
        return
    m = tk.Menu(W.root, tearoff: false)
    for p in 목록
        m.add_command(label: p, command: () => 파일열기(p))
    m.tk_popup(W.root.winfo_pointerx(), W.root.winfo_pointery())

fn 저장하기(다른이름)
    경로 = S.file
    if 다른이름 or 경로 == null
        경로 = fd.asksaveasfilename(defaultextension: ".poi", filetypes: [["POI 파일", "*.poi"]])
    if not 경로
        return
    file.write(경로, 본문())
    S.file = 경로
    S.dirty = false
    _recent_add(경로)
    제목갱신()
    로그("저장했어요:  {경로}")

fn 저장()
    저장하기(false)

fn 다른이름저장()
    저장하기(true)

fn 콘솔지우기()
    W.out.config(state: "normal")
    W.out.delete("1.0", "end")
    W.out.config(state: "disabled")

fn 로그(줄)
    출력추가("{줄}\n")

fn 출력추가(조각)
    W.out.config(state: "normal")
    W.out.insert("end", 조각)
    W.out.see("end")
    W.out.config(state: "disabled")

fn 펌프()
    for 조각 in _drain()
        if 조각 == "<<<idle-done>>>"
            실행끝()
        else
            출력추가(조각)
    if S.running
        W.root.after(40, 펌프)

fn 실행끝()
    S.running = false
    W.run_btn.config(text: "▶  실행  (F5)", bg: "#3182f6")
    로그("────────────────────────────────────────")

fn 실행()
    if S.running
        _kill_worker()
        return
    콘솔지우기()
    로그("▶  실행 중 …")
    S.running = true
    W.run_btn.config(text: "■  중단", bg: "#e03131")
    _run_poi(본문(), 현재폴더())
    W.root.after(40, 펌프)
    W.root.after(8000, 시간초과)

fn 시간초과()
    if S.running
        _kill_worker()

fn 터미널실행()
    if S.file == null or S.dirty
        저장()
    if S.file == null
        return
    if _run_terminal(S.file, 현재폴더())
        로그("터미널에서 실행했어요:  {S.file}")

fn 편집됨(e)
    if W.editor.edit_modified()
        S.dirty = true
        제목갱신()
        _highlight(W.editor)
        W.editor.edit_modified(false)

fn 커서이동(e)
    자리 = W.editor.index("insert").split(".")
    W.status.config(text: "  {자리[0]}줄  {자리[1]}칸     POI {버전}   ·   F5 실행 · Ctrl+S 저장 · Ctrl+/ 주석 · Ctrl+F 찾기 · Ctrl+± 확대")

fn 예제넣기()
    본문설정(SAMPLE)
    S.dirty = false
    제목갱신()

# ── 창 만들기 ───────────────────────────────────────────────────────
W.root = tk.Tk()
W.root.geometry("1040x700")
W.root.minsize(720, 480)
W.root.configure(bg: "#0f1115")

글꼴 = tkfont.Font(family: "Consolas", size: 12)
ui = tkfont.Font(family: "Segoe UI", size: 10)

fn 버튼(부모, 라벨, 동작, 강조)
    색 = "#242a33"
    글자 = "#e6e9ef"
    if 강조
        색 = "#3182f6"
        글자 = "#ffffff"
    b = tk.Button(부모, text: 라벨, command: 동작, bg: 색, fg: 글자,
                  activebackground: 색, activeforeground: 글자, relief: "flat",
                  font: ui, padx: 12, pady: 6, borderwidth: 0, cursor: "hand2")
    b.pack(side: "left", padx: 4, pady: 7)
    return b

W.bar = tk.Frame(W.root, bg: "#161a20")
W.bar.pack(side: "top", fill: "x")
버튼(W.bar, "＋ 새로", 새파일, false)
버튼(W.bar, "📂 열기", 열기, false)
버튼(W.bar, "🕘 최근", 최근, false)
버튼(W.bar, "💾 저장", 저장, false)
W.run_btn = 버튼(W.bar, "▶  실행  (F5)", 실행, true)
버튼(W.bar, "⧉ 터미널", 터미널실행, false)
버튼(W.bar, "✦ 예제", 예제넣기, false)
버튼(W.bar, "🧹 콘솔", 콘솔지우기, false)

W.mid = tk.Frame(W.root, bg: "#0f1115")
W.mid.pack(side: "top", fill: "both", expand: true)

W.editor = tk.Text(W.mid, wrap: "none", undo: true, font: 글꼴,
                   bg: "#0f1115", fg: "#e6e9ef", insertbackground: "#3182f6",
                   selectbackground: "#2a3b57", relief: "flat",
                   padx: 14, pady: 12, spacing1: 2, spacing3: 2, maxundo: 500)

W.gpair = _make_gutter(W.mid, W.editor, 글꼴)
W.gutter = W.gpair[0]
W.gutter_refresh = W.gpair[1]
W.gutter.pack(side: "left", fill: "y")
W.editor.pack(side: "left", fill: "both", expand: true)
W.scroll = tk.Scrollbar(W.mid, command: W.editor.yview)
W.scroll.pack(side: "right", fill: "y")
W.editor.configure(yscrollcommand: W.scroll.set)

W.editor.tag_configure("kw", foreground: "#5aa2ff")
W.editor.tag_configure("str", foreground: "#63d19e")
W.editor.tag_configure("com", foreground: "#6b7480")
W.editor.tag_configure("num", foreground: "#e0a458")
W.editor.tag_configure("fn", foreground: "#c792ea")

_wire_editor(W.editor, 글꼴, 실행)

W.console = tk.Frame(W.root, bg: "#0b0d10")
W.console.pack(side: "top", fill: "both")
W.out_label = tk.Label(W.console, text: "  출력", bg: "#0b0d10", fg: "#6b7480",
                       font: ui, anchor: "w")
W.out_label.pack(side: "top", fill: "x", pady: 3)
W.out = tk.Text(W.console, height: 12, wrap: "word", font: 글꼴,
                bg: "#0b0d10", fg: "#c9cdd6", relief: "flat",
                padx: 16, pady: 10, state: "disabled")
W.out.pack(side: "top", fill: "both")

W.status = tk.Label(W.root, text: "  준비됨        POI {버전}", bg: "#161a20",
                    fg: "#8b95a1", font: ui, anchor: "w")
W.status.pack(side: "bottom", fill: "x")

W.editor.bind("<<Modified>>", 편집됨)
W.editor.bind("<KeyRelease>", 커서이동, add: "+")
W.editor.bind("<ButtonRelease-1>", 커서이동)
W.root.bind("<F5>", (e) => 실행())
W.root.bind("<Control-s>", (e) => 저장())
W.root.bind("<Control-Shift-S>", (e) => 다른이름저장())
W.root.bind("<Control-n>", (e) => 새파일())
W.root.bind("<Control-o>", (e) => 열기())
W.root.bind("<Control-r>", (e) => 터미널실행())

열대상 = _open_target()
if 열대상
    파일열기(열대상)
else
    예제넣기()
커서이동(null)
W.editor.focus_set()
W.root.mainloop()
