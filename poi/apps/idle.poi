# ┌─────────────────────────────────────────────────────────────────┐
# │  POI IDLE  —  POI 로 작성한 코드 편집기                          │
# │  실행:  poi idle [파일.poi]      빌드:  poi build --app idle     │
# │  이 파일 자체가 POI 프로그램입니다 (tkinter 위에서).            │
# └─────────────────────────────────────────────────────────────────┘

use py:tkinter as tk
use py:tkinter.font as tkfont
use py:tkinter.filedialog as fd
use py:tkinter.messagebox as mb
use py:tkinter.simpledialog as sd

# ── 실행 엔진 · 문법 강조 · 편집 편의기능 (파이썬 상호운용) ───────────
python {
    import io, re, os, sys, json, queue, threading, contextlib, ctypes, traceback, subprocess

    _KW = ("show|ask|use|python|try|catch|if|else|elif|for|in|while|repeat|"
           "fn|def|func|function|fun|lambda|pass|return|end|match|when|is|between|and|or|not|as|const|let|"
           "server|webapp|page|state|action|app|window|raise|assert|test|true|false|null|"
           "True|False|None|background|every|task|http|net")
    _KW_RE  = re.compile(r"(?<![\w.])(" + _KW + r")(?![\w])")
    _STR_RE = re.compile(r'"(?:[^"\\]|\\.)*"')
    _COM_RE = re.compile(r"#[^\n]*")
    _NUM_RE = re.compile(r"(?<![\w.])\d+(?:\.\d+)?")
    _FN_RE  = re.compile(r"(?<=\bfn\s)([A-Za-z_가-힣][\w가-힣]*)")

    def _highlight(txt):
        for tag in ("kw", "str", "com", "num", "fn"):
            txt.tag_remove(tag, "1.0", "end")
        body = txt.get("1.0", "end-1c")
        for tag, rx in (("str", _STR_RE), ("com", _COM_RE),
                        ("kw", _KW_RE), ("num", _NUM_RE), ("fn", _FN_RE)):
            for m in rx.finditer(body):
                txt.tag_add(tag, "1.0+%dc" % m.start(), "1.0+%dc" % m.end())

    # ── 실행 (별도 스레드 + 타임아웃) ──────────────────────────────
    _Q = queue.Queue()
    _ASK_Q = queue.Queue()
    _worker = {"tid": None}

    # ask "..." → 대화상자 (워커 스레드가 요청, 메인 스레드가 처리)
    def _idle_ask(prompt):
        box, ev = {}, threading.Event()
        _ASK_Q.put((prompt, box, ev))
        ev.wait()
        return box.get("v", "")

    def _pump_ask(root):
        try:
            while True:
                prompt, box, ev = _ASK_Q.get_nowait()
                try:
                    box["v"] = sd.askstring("입력", prompt or "값:", parent=root) or ""
                finally:
                    ev.set()
        except queue.Empty:
            pass

    try:
        from poi.runtime.builtins import poi_set_ask
        poi_set_ask(_idle_ask)
    except Exception:
        pass

    def _kill_worker():
        tid = _worker.get("tid")
        if tid:
            ctypes.pythonapi.PyThreadState_SetAsyncExc(
                ctypes.c_long(tid), ctypes.py_object(KeyboardInterrupt))

    def _drain():
        out = []
        try:
            while True:
                out.append(_Q.get_nowait())
        except queue.Empty:
            pass
        return out

    _web_state = {"httpd": None, "url": None}

    def _web_running():
        return _web_state["httpd"] is not None

    def _web_stop():
        h = _web_state.get("httpd")
        _web_state["httpd"] = None
        _web_state["url"] = None
        if h is not None:
            try:
                h.shutdown()
                h.server_close()
            except Exception:
                pass

    def _web_start(port_hint):
        from poi.runtime import webserver as ws
        last = None
        for p in range(int(port_hint), int(port_hint) + 12):
            try:
                httpd, url = ws.start(p, "127.0.0.1", on_log=lambda s: _Q.put(s))
                _web_state["httpd"] = httpd
                _web_state["url"] = url
                return url
            except Exception as e:
                last = e
        _Q.put("웹 서버를 열지 못했어요: %s\n" % last)
        return None

    def _run_poi(src, base_dir, web_port=8900):
        from poi.interpreter import compile_source
        from poi.runtime import make_globals
        from poi.runtime import webserver as _ws

        class _Pipe(io.TextIOBase):
            def write(self, s):
                if s:
                    _Q.put(s)
                return len(s)

        def job():
            _worker["tid"] = threading.get_ident()
            _web_stop()
            _ws.reset()
            g = make_globals()
            g["__name__"] = "__main__"
            g["__poi_dir__"] = base_dir or os.getcwd()
            os.environ["POI_NO_SERVE"] = "1"     # 서버 기동은 IDLE 이 직접
            code = None
            try:
                py, _lm, cn = compile_source(src, "<idle>")
                code = compile(py, cn, "exec")
            except Exception as e:
                _Q.put(getattr(e, "render", lambda _s: str(e))(src) + "\n")
            if code is not None:
                cwd0 = os.getcwd()
                try:
                    if base_dir and os.path.isdir(base_dir):
                        os.chdir(base_dir)
                    with contextlib.redirect_stdout(_Pipe()), \
                         contextlib.redirect_stderr(_Pipe()):
                        exec(code, g)
                except SystemExit:
                    pass
                except KeyboardInterrupt:
                    _Q.put("\n[중단됨 — 실행이 너무 오래 걸렸어요]\n")
                except Exception as e:
                    from poi.errors import translate_exception
                    try:
                        _Q.put("\n" + translate_exception(e, src, {}, "<idle>").render(src) + "\n")
                    except Exception:
                        _Q.put("\n" + traceback.format_exc() + "\n")
                finally:
                    os.chdir(cwd0)
                if g.get("__poi_has_web__"):
                    url = _web_start(web_port)
                    if url:
                        _Q.put("\n  🌐  웹 서버 실행 중  →  " + url + "\n")
                        _Q.put("      (브라우저가 자동으로 열립니다. '■ 서버 중지' 로 종료)\n")
                        try:
                            import webbrowser
                            webbrowser.open(url)
                        except Exception:
                            pass
                        _worker["tid"] = None
                        _Q.put("<<<idle-serving>>>")
                        return
            _worker["tid"] = None
            _Q.put("<<<idle-done>>>")

        threading.Thread(target=job, daemon=True).start()

    # ── 터미널에서 실행 (진짜 콘솔 창) ────────────────────────────
    def _poi_launcher():
        if getattr(sys, "frozen", False):
            cand = os.path.join(os.path.dirname(sys.executable), "poi.exe")
            if os.path.isfile(cand):
                return [cand]
        return [sys.executable, "-m", "poi"]

    def _run_terminal(path, base_dir):
        argv = _poi_launcher() + ["run", path]
        try:
            if os.name == "nt":
                subprocess.Popen(["cmd", "/c", "start", "POI",
                                  "cmd", "/k"] + argv, cwd=base_dir or None)
            else:
                subprocess.Popen(argv, cwd=base_dir or None)
            return True
        except Exception as e:
            _Q.put("터미널 실행 실패: %s\n" % e)
            return False

    def _pw_entry(parent, **kw):
        import tkinter as _tk2
        return _tk2.Entry(parent, show="•", **kw)

    def _obf_preview_bg(path):
        def job():
            try:
                from poi.interpreter import compile_source
                from poi.protect import obfuscate_py
                py, _lm, _cn = compile_source(open(path, encoding="utf-8").read(),
                                              os.path.basename(path))
                ob = obfuscate_py(py)
                _Q.put(ob[:6000] + ("\n… (%d자)\n" % len(ob) if len(ob) > 6000 else "\n"))
                _Q.put("\n원본 함수·변수 이름이 사라졌는지 확인하세요.\n")
            except Exception as e:
                _Q.put("난독화 실패: %s\n" % e)
            _Q.put("<<<idle-done>>>")
        threading.Thread(target=job, daemon=True).start()

    def _decompile_bg(exe_path):
        def job():
            try:
                from poi.protect import decompile_exe
                out = os.path.join(os.path.dirname(exe_path), "decompiled")
                r = decompile_exe(exe_path, out)
                _Q.put("엔트리 %d개 중 %d개를 복원 → %s\n" %
                       (r["entries"], len(r["files"]), out))
                if r.get("native"):
                    _Q.put("→ POI 전용 EXE 검사 완료 · 보호 방식: %s\n" % r.get("mode", "-"))
                    for n in r["notes"][:6]:
                        _Q.put("  · %s\n" % n)
                    _Q.put("<<<idle-done>>>")
                    return
                app = [f for f in r["files"]
                       if os.path.basename(f).lower().startswith("_poi_app")
                       or os.path.basename(f).lower().endswith("app.recovered.py")]
                apppy = [f for f in app if f.lower().endswith(".py")]
                if apppy:
                    t = open(apppy[0], encoding="utf-8", errors="replace").read()
                    if t.lstrip().startswith("import base64") and "_z.decompress" in t:
                        _Q.put("→ 앱 코드가 난독화돼 있어 읽기 어렵습니다 (보호 성공).\n")
                    elif "_unlock" in t or "make_locked_entry" in t:
                        _Q.put("→ 앱 코드가 비밀번호로 잠겨 있어 비번 없이는 못 엽니다.\n")
                    else:
                        _Q.put("→ 변환된 소스가 그대로 복원됐습니다.\n"
                               "   보호하려면 EXE 빌드에서 '난독화' 나 '비밀번호' 를 켜세요.\n")
                elif app:
                    _Q.put("→ 앱 진입점이 %s 로만 나왔습니다 — 비번 잠금 exe 는 "
                           "비번 없이 앱 코드가 안 풀립니다 (보호 성공).\n"
                           % os.path.basename(app[0]))
                for n in r["notes"][:6]:
                    _Q.put("  · %s\n" % n)
            except Exception as e:
                _Q.put("디컴파일 실패: %s\n" % e)
            _Q.put("<<<idle-done>>>")
        threading.Thread(target=job, daemon=True).start()

    def _build_exe_bg(build_args, base_dir):
        def job():
            argv = _poi_launcher() + list(build_args)
            try:
                p = subprocess.Popen(argv, cwd=base_dir or None,
                                     stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, text=True,
                                     encoding="utf-8", errors="replace")
                for line in p.stdout:
                    _Q.put(line)
                p.wait()
                _Q.put("\n[빌드 %s]\n" % ("완료 — dist/ 폴더 확인"
                                        if p.returncode == 0 else "실패"))
            except Exception as e:
                _Q.put("빌드 실행 실패: %s\n" % e)
            _Q.put("<<<idle-done>>>")
        threading.Thread(target=job, daemon=True).start()

    # ── 최근 파일 ────────────────────────────────────────────────
    _RECENT = os.path.join(os.path.expanduser("~"), ".poi", "idle_recent.json")

    def _recent_load():
        try:
            with open(_RECENT, encoding="utf-8") as f:
                return [p for p in json.load(f) if os.path.isfile(p)]
        except Exception:
            return []

    def _recent_add(path):
        if not path:
            return
        items = [path] + [p for p in _recent_load() if p != path]
        items = items[:8]
        try:
            os.makedirs(os.path.dirname(_RECENT), exist_ok=True)
            with open(_RECENT, "w", encoding="utf-8") as f:
                json.dump(items, f, ensure_ascii=False)
        except Exception:
            pass

    def _open_target():
        p = os.environ.get("POI_IDLE_OPEN", "")
        return p if p and os.path.isfile(p) else ""

    _WEB_RE = re.compile(r'(?m)^[ \t]*(server|webapp)\b')
    _GUI_RE = re.compile(r'(?m)^[ \t]*(?:app[ \t]+"|window[ \t]*\{)')

    def _has_web(src):
        return bool(_WEB_RE.search(src or ""))

    def _has_gui(src):
        return bool(_GUI_RE.search(src or ""))

    def _run_gui_subprocess(path, base_dir):
        argv = _poi_launcher() + ["run", "--no-banner", path]
        try:
            if getattr(sys, "frozen", False) and os.name == "nt":
                subprocess.Popen(argv, cwd=base_dir or None,
                                 creationflags=getattr(subprocess,
                                                       "DETACHED_PROCESS", 0))
            else:
                subprocess.Popen(argv, cwd=base_dir or None)
            return True
        except Exception as e:
            _Q.put("GUI 실행 실패: %s\n" % e)
            return False

    def _web_entry(folder):
        """폴더에서 server/webapp 이 있는 .poi 진입점을 찾는다."""
        for name in ("main.poi", "app.poi", "server.poi", "web.poi", "index.poi"):
            p = os.path.join(folder, name)
            if os.path.isfile(p):
                try:
                    if _has_web(open(p, encoding="utf-8").read()):
                        return p
                except Exception:
                    pass
        try:
            for name in sorted(os.listdir(folder)):
                if name.endswith(".poi"):
                    p = os.path.join(folder, name)
                    if _has_web(open(p, encoding="utf-8").read()):
                        return p
        except Exception:
            pass
        return None

    # ── 하온 (로컬 에이전트) ─────────────────────────────────────
    _HAON_Q = queue.Queue()
    try:
        from poi.apps import haon as _haon
        from poi.apps import haon_gpt as _haon_gpt
        _HAON = _haon.detect()
    except Exception:
        _haon = None
        _haon_gpt = None
        _HAON = {"mode": "none", "gpu": None}

    def _haon_badge():
        if not _haon:
            return "하온 — 사용 불가"
        if _haon_gpt:
            st = _haon_gpt.status()
            if st.get("logged_in") and not st.get("expired"):
                who = st.get("email") or "ChatGPT 계정"
                return "하온 · ChatGPT (%s)" % who
            return "하온 · ChatGPT 로그인 필요"
        m = _HAON.get("mode")
        if m == "groq":
            left, wait = _haon.rate_state()
            return "하온 · Groq (%s)  ·  이번 창에서 %d번 더 (5분 창)" % (
                _HAON.get("groq_model", "llama-3.3"), left)
        if m == "ollama":
            return "하온 · 로컬 LLM (%s)  ·  %s" % (
                (_HAON["models"][0] if _HAON.get("models") else "ollama"),
                _HAON.get("gpu") or "CPU")
        return ("하온 · 규칙 기반 (실제 컴파일러로 오류 수정).  "
                "Groq 쓰려면 GROQ_API_KEY 또는 ~/.poi/groq.key")

    def _haon_ask(q, code):
        def job():
            try:
                _HAON_Q.put(("say", _haon.chat(q, code, _HAON)))
            except Exception as e:
                _HAON_Q.put(("say", "하온 오류: %s" % e))
        threading.Thread(target=job, daemon=True).start()

    def _haon_autofix(src):
        def job():
            try:
                new, log = _haon.autofix(src)
                _HAON_Q.put(("fix", new, "\n".join(log)))
            except Exception as e:
                _HAON_Q.put(("say", "자동 수정 오류: %s" % e))
        threading.Thread(target=job, daemon=True).start()

    _HAON_BUSY = {"v": False}
    _HAON_LOGIN = {"started": False, "busy": False}

    def _haon_login(force=False):
        """하온을 처음 열면 ChatGPT OAuth를 즉시 시작한다."""
        if not _haon_gpt or _HAON_LOGIN["busy"]:
            return False
        st = _haon_gpt.status()
        if st.get("logged_in") and not st.get("expired"):
            return False
        if _HAON_LOGIN["started"] and not force:
            return False
        # GUI 자체 점검에서는 실제 브라우저/OAuth 서버를 열지 않는다.
        if os.environ.get("POI_IDLE_SELFTEST") == "1":
            return False
        _HAON_LOGIN["started"] = True
        _HAON_LOGIN["busy"] = True

        def job():
            try:
                ok = _haon_gpt.login(
                    lambda s: _HAON_Q.put(("auth-log", str(s))))
                _HAON_Q.put(("auth-done", bool(ok)))
            except Exception as e:
                _HAON_Q.put(("auth-log", "ChatGPT 로그인 오류: %s" % e))
                _HAON_Q.put(("auth-done", False))
            finally:
                _HAON_LOGIN["busy"] = False
        threading.Thread(target=job, daemon=True).start()
        return True

    def _haon_install():
        if _HAON_BUSY["v"] or not _haon:
            return
        _HAON_BUSY["v"] = True

        def job():
            try:
                ok = _haon.ensure_model(lambda s: _HAON_Q.put(("say", s)))
                if ok:
                    _HAON.clear()
                    _HAON.update(_haon.detect())
                    _HAON_Q.put(("badge", ""))
            except Exception as e:
                _HAON_Q.put(("say", "설치 오류: %s" % e))
            finally:
                _HAON_BUSY["v"] = False
        threading.Thread(target=job, daemon=True).start()

    def _haon_drain():
        out = []
        try:
            while True:
                out.append(_HAON_Q.get_nowait())
        except queue.Empty:
            pass
        return out

    # ── 테마 (라이트 기본 / 다크 토글) ────────────────────────────
    THEMES = {
        "light": {
            "bg": "#ffffff", "bg2": "#f2f4f6", "panel": "#f7f8fa",
            "ink": "#191f28", "ink2": "#4e5968", "ink3": "#8b95a1",
            "line": "#e5e8eb", "blue": "#3182f6", "sel": "#d7e6ff",
            "kw": "#0b62d6", "str": "#1a7f37", "com": "#8b95a1",
            "num": "#b3560f", "fn": "#8250df", "octo": "#3182f6",
            "console": "#f7f8fa", "consink": "#333d4b", "gutter": "#9aa3af",
        },
        "dark": {
            "bg": "#0f1115", "bg2": "#161a20", "panel": "#0b0d10",
            "ink": "#e6e9ef", "ink2": "#a9aeb8", "ink3": "#6b7480",
            "line": "#2b2e36", "blue": "#3182f6", "sel": "#2a3b57",
            "kw": "#5aa2ff", "str": "#63d19e", "com": "#6b7480",
            "num": "#e0a458", "fn": "#c792ea", "octo": "#5aa2ff",
            "console": "#0b0d10", "consink": "#c9cdd6", "gutter": "#4a525e",
        },
    }
    _CFG = os.path.join(os.path.expanduser("~"), ".poi", "idle.json")

    def _cfg_load():
        try:
            with open(_CFG, encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}

    def _cfg_save(d):
        try:
            os.makedirs(os.path.dirname(_CFG), exist_ok=True)
            with open(_CFG, "w", encoding="utf-8") as f:
                json.dump(d, f)
        except Exception:
            pass

    # ── 에디터 편의기능 (자동 들여쓰기 · 괄호 · 주석 · 확대) ────────
    _PAIRS = {"(": ")", "[": "]", "{": "}", '"': '"'}

    def _wire_editor(txt, font, run_cb):
        def on_return(e):
            line = txt.get("insert linestart", "insert")
            indent = re.match(r"[ \t]*", line).group(0)
            stripped = line.strip()
            if stripped.endswith(("{", ":")) or re.match(
                    r"(fn|def|if|else|elif|for|while|repeat|try|catch|match|when|"
                    r"server|webapp|page|state|action|app|window|background|every)\b", stripped):
                indent += "    "
            txt.insert("insert", "\n" + indent)
            txt.see("insert")
            return "break"

        def on_pair(e):
            ch = e.char
            close = _PAIRS[ch]
            try:
                sel = txt.get("sel.first", "sel.last")
                txt.delete("sel.first", "sel.last")
                txt.insert("insert", ch + sel + close)
            except tk.TclError:
                nxt = txt.get("insert", "insert+1c")
                if ch == '"' and nxt == '"':
                    txt.mark_set("insert", "insert+1c")
                    return "break"
                txt.insert("insert", ch + close)
                txt.mark_set("insert", "insert-1c")
            return "break"

        def indent_sel(e):
            try:
                a = int(txt.index("sel.first").split(".")[0])
                b = int(txt.index("sel.last").split(".")[0])
            except tk.TclError:
                txt.insert("insert", "    ")
                return "break"
            for ln in range(a, b + 1):
                txt.insert("%d.0" % ln, "    ")
            return "break"

        def dedent_sel(e):
            try:
                a = int(txt.index("sel.first").split(".")[0])
                b = int(txt.index("sel.last").split(".")[0])
            except tk.TclError:
                a = b = int(txt.index("insert").split(".")[0])
            for ln in range(a, b + 1):
                head = txt.get("%d.0" % ln, "%d.4" % ln)
                cut = len(head) - len(head.lstrip(" "))
                if cut:
                    txt.delete("%d.0" % ln, "%d.%d" % (ln, min(cut, 4)))
            return "break"

        def toggle_comment(e):
            try:
                a = int(txt.index("sel.first").split(".")[0])
                b = int(txt.index("sel.last").split(".")[0])
            except tk.TclError:
                a = b = int(txt.index("insert").split(".")[0])
            lines = [txt.get("%d.0" % ln, "%d.end" % ln) for ln in range(a, b + 1)]
            on = all((not s.strip()) or s.lstrip().startswith("# ") for s in lines)
            for i, ln in enumerate(range(a, b + 1)):
                s = lines[i]
                if not s.strip():
                    continue
                if on:
                    idx = s.index("# ")
                    txt.delete("%d.%d" % (ln, idx), "%d.%d" % (ln, idx + 2))
                else:
                    txt.insert("%d.0" % ln, "# ")
            return "break"

        def zoom(delta):
            def _f(e=None):
                sz = max(8, min(40, int(font.cget("size")) + delta))
                font.configure(size=sz)
                return "break"
            return _f

        def dup_line(e):
            s = txt.get("insert linestart", "insert lineend")
            txt.insert("insert lineend", "\n" + s)
            return "break"

        def find(e=None):
            q = sd.askstring("찾기", "찾을 내용:", parent=txt.winfo_toplevel())
            if not q:
                return "break"
            txt.tag_remove("find", "1.0", "end")
            start = "insert"
            pos = txt.search(q, start, stopindex="end", nocase=True)
            if not pos:
                pos = txt.search(q, "1.0", stopindex="end", nocase=True)
            if pos:
                end = "%s+%dc" % (pos, len(q))
                txt.tag_add("find", pos, end)
                txt.tag_configure("find", background="#3d5a80", foreground="#fff")
                txt.mark_set("insert", end)
                txt.see(pos)
            return "break"

        for ch in _PAIRS:
            txt.bind(ch, on_pair)
        txt.bind("<Return>", on_return)
        txt.bind("<Tab>", indent_sel)
        txt.bind("<Shift-Tab>", dedent_sel)
        txt.bind("<ISO_Left_Tab>", dedent_sel)
        txt.bind("<Control-slash>", toggle_comment)
        txt.bind("<Control-d>", dup_line)
        txt.bind("<Control-f>", find)
        txt.bind("<Control-equal>", zoom(1))
        txt.bind("<Control-plus>", zoom(1))
        txt.bind("<Control-minus>", zoom(-1))
        txt.bind("<Control-0>", lambda e: (font.configure(size=12), "break")[1])

    # ── 줄번호 여백 ──────────────────────────────────────────────
    def _make_gutter(parent, txt, font):
        g = tk.Text(parent, width=5, padx=8, takefocus=0, border=0,
                    bg="#0b0d10", fg="#4a525e", font=font, state="disabled",
                    cursor="arrow", spacing1=2, spacing3=2)

        def refresh(e=None):
            n = int(txt.index("end-1c").split(".")[0])
            g.config(state="normal")
            g.delete("1.0", "end")
            g.insert("1.0", "\n".join("%4d" % i for i in range(1, n + 1)))
            g.config(state="disabled")
            g.yview_moveto(txt.yview()[0])

        txt.bind("<KeyRelease>", refresh, add="+")
        txt.bind("<MouseWheel>", lambda e: txt.after(1, refresh), add="+")
        txt.bind("<Configure>", refresh, add="+")
        parent.after(60, refresh)
        return g, refresh

    try:
        from poi.octopus_art import LINES as OCTO
    except Exception:
        OCTO = []

    SAMPLE = (
        '# POI 에 오신 걸 환영해요. F5 를 누르면 실행됩니다.\n\n'
        'show "안녕하세요, POI!"\n\n'
        'fn 인사(이름)\n'
        '    return "반가워요 {이름}님"\n\n'
        'for 사람 in ["시원", "민수", "지연"]\n'
        '    show 인사(사람)\n\n'
        '합 = 0\n'
        'repeat 10 as i\n'
        '    합 = 합 + i\n'
        'show "0~9 합계는 {합}"\n'
    )
}

# ── 상태 · 위젯 보관함 (POI 함수는 전역 재대입을 안 하므로 Box 로) ────
S = { file: null, dirty: false, running: false, serving: false, port: 8900, splash: 0, theme: "light" }
W = {}
버전 = system.poi_version()

fn 현재폴더()
    if S.file != null
        return path.dir(S.file)
    return system.cwd()

# ── 동작 ────────────────────────────────────────────────────────────
fn 제목갱신()
    이름 = "이름 없음"
    if S.file != null
        이름 = path.base(S.file)
    표시 = ""
    if S.dirty
        표시 = " ●"
    W.root.title("POI IDLE  —  {이름}{표시}")

fn 본문()
    return W.editor.get("1.0", "end-1c")

fn 본문설정(글)
    W.editor.delete("1.0", "end")
    W.editor.insert("1.0", 글)
    _highlight(W.editor)
    W.editor.edit_modified(false)
    W.gutter_refresh(null)
    모드표시()

fn 새파일()
    if S.dirty and not mb.askokcancel("새 파일", "저장하지 않은 변경이 있어요. 계속할까요?")
        return
    S.file = null
    S.dirty = false
    본문설정("")
    제목갱신()
    로그("새 파일을 만들었어요.")

fn 파일열기(경로)
    try
        본문설정(file.read(경로))
        S.file = 경로
        S.dirty = false
        _recent_add(경로)
        제목갱신()
        로그("열었어요:  {경로}")
    catch e
        mb.showerror("열기 실패", "{e}")

fn 열기()
    경로 = fd.askopenfilename(filetypes: [["POI 파일", "*.poi"], ["모든 파일", "*.*"]])
    if 경로
        파일열기(경로)

fn 최근()
    목록 = _recent_load()
    if not 목록
        로그("최근 연 파일이 없어요.")
        return
    m = tk.Menu(W.root, tearoff: false)
    for p in 목록
        m.add_command(label: p, command: () => 파일열기(p))
    m.tk_popup(W.root.winfo_pointerx(), W.root.winfo_pointery())

fn 저장하기(다른이름)
    경로 = S.file
    if 다른이름 or 경로 == null
        경로 = fd.asksaveasfilename(defaultextension: ".poi", filetypes: [["POI 파일", "*.poi"]])
    if not 경로
        return
    file.write(경로, 본문())
    S.file = 경로
    S.dirty = false
    _recent_add(경로)
    제목갱신()
    로그("저장했어요:  {경로}")

fn 저장()
    저장하기(false)

fn 다른이름저장()
    저장하기(true)

fn 콘솔지우기()
    W.out.config(state: "normal")
    W.out.delete("1.0", "end")
    W.out.config(state: "disabled")

fn 로그(줄)
    출력추가("{줄}\n")

fn 출력추가(조각)
    W.out.config(state: "normal")
    W.out.insert("end", 조각)
    W.out.see("end")
    W.out.config(state: "disabled")

fn 펌프()
    _pump_ask(W.root)
    for 조각 in _drain()
        if 조각 == "<<<idle-done>>>"
            실행끝()
        else if 조각 == "<<<idle-serving>>>"
            서버시작됨()
        else
            출력추가(조각)
    if S.running or S.serving
        W.root.after(60, 펌프)

fn 실행끝()
    S.running = false
    W.run_btn.config(bg: "#3182f6", fg: "#ffffff")
    모드표시()
    로그("────────────────────────────────────────")

fn 서버시작됨()
    S.running = false
    S.serving = true
    W.run_btn.config(text: "■  서버 중지", bg: "#e03131", fg: "#ffffff")

fn 서버중지()
    _web_stop()
    S.serving = false
    W.run_btn.config(bg: "#3182f6", fg: "#ffffff")
    모드표시()
    로그("웹 서버를 멈췄어요.")
    로그("────────────────────────────────────────")

fn 실행()
    if S.serving
        서버중지()
        return
    if S.running
        _kill_worker()
        return
    콘솔지우기()
    글 = 본문()
    if _has_gui(글)
        # GUI 앱은 별도 프로세스로 (IDLE 안에서 두 번째 tkinter 는 위험)
        if S.file == null or S.dirty
            저장()
        if S.file != null
            로그("🖥️  GUI 앱을 새 창으로 실행합니다 …")
            _run_gui_subprocess(S.file, 현재폴더())
        return
    if _has_web(글)
        로그("🌐  웹 서버 준비 중 …")
    else
        로그("▶  실행 중 …")
    S.running = true
    W.run_btn.config(text: "■  중단", bg: "#e03131", fg: "#ffffff")
    _run_poi(글, 현재폴더(), S.port)
    W.root.after(40, 펌프)
    if not _has_web(글)
        W.root.after(8000, 시간초과)

fn 모드표시()
    글 = 본문()
    if S.serving
        return
    if _has_web(글)
        W.run_btn.config(text: "🌐  웹 서버 (F5)")
        W.mode_lbl.config(text: "웹 서버")
    else if _has_gui(글)
        W.run_btn.config(text: "🖥️  GUI 실행 (F5)")
        W.mode_lbl.config(text: "GUI 앱")
    else
        W.run_btn.config(text: "▶  실행  (F5)")
        W.mode_lbl.config(text: "")

fn 시간초과()
    if S.running
        _kill_worker()

fn 터미널실행()
    if S.file == null or S.dirty
        저장()
    if S.file == null
        return
    if _run_terminal(S.file, 현재폴더())
        로그("터미널에서 실행했어요:  {S.file}")

fn EXE빌드()
    if S.file == null or S.dirty
        저장()
    if S.file == null
        로그("먼저 파일을 저장하세요.")
        return
    top = tk.Toplevel(W.root)
    top.title("EXE 빌드")
    top.configure(bg: T.bg2)
    top.transient(W.root)
    tk.Label(top, text: "  " + path.base(S.file) + " → 단일 실행파일", bg: T.bg2,
             fg: T.ink, font: ui).pack(anchor: "w", padx: 14, pady: 10)

    fn 줄(라벨, 기본)
        f = tk.Frame(top, bg: T.bg2)
        f.pack(anchor: "w", fill: "x", padx: 16, pady: 3)
        tk.Label(f, text: 라벨, bg: T.bg2, fg: T.ink2, font: ui, width: 12,
                 anchor: "w").pack(side: "left")
        e = tk.Entry(f, font: ui, relief: "flat", bg: T.bg, fg: T.ink, width: 26)
        e.insert(0, 기본)
        e.pack(side: "left", fill: "x", expand: true)
        return e

    이름칸 = 줄("파일 이름", path.stem(S.file))
    작자칸 = 줄("작자 / 회사", "")
    버전칸 = 줄("버전", "1.0.0")

    난독 = tk.IntVar(value: 1)
    콘솔 = tk.IntVar(value: 1)
    tk.Checkbutton(top, text: "난독화 후 패키징 (쉽게 못 읽게)", variable: 난독, bg: T.bg2,
                   fg: T.ink, selectcolor: T.bg, activebackground: T.bg2).pack(anchor: "w", padx: 16, pady: [8, 0])
    tk.Checkbutton(top, text: "콘솔 창 표시", variable: 콘솔, bg: T.bg2,
                   fg: T.ink, selectcolor: T.bg, activebackground: T.bg2).pack(anchor: "w", padx: 16)
    비번칸프레임 = tk.Frame(top, bg: T.bg2)
    비번칸프레임.pack(anchor: "w", fill: "x", padx: 16, pady: 3)
    tk.Label(비번칸프레임, text: "비밀번호(선택)", bg: T.bg2, fg: T.ink2, font: ui,
             width: 12, anchor: "w").pack(side: "left")
    비번 = _pw_entry(비번칸프레임, font: ui, relief: "flat", bg: T.bg, fg: T.ink, width: 26)
    비번.pack(side: "left", fill: "x", expand: true)
    실행시물음 = tk.IntVar(value: 0)
    tk.Checkbutton(top, text: "비번을 exe 에 안 넣고 실행할 때 물어보기 (가장 안전)",
                   variable: 실행시물음, bg: T.bg2, fg: T.ink,
                   selectcolor: T.bg, activebackground: T.bg2).pack(anchor: "w", padx: 16)

    fn 시작()
        인자 = ["build", S.file]
        if 이름칸.get().strip() != ""
            인자 = 인자 + ["-o", 이름칸.get().strip()]
        if 작자칸.get().strip() != ""
            인자 = 인자 + ["--author", 작자칸.get().strip()]
        if 버전칸.get().strip() != ""
            인자 = 인자 + ["--file-version", 버전칸.get().strip()]
        if 난독.get() == 1 and 비번.get() == ""
            인자 = 인자 + ["--obfuscate"]
        if 콘솔.get() == 1
            인자 = 인자 + ["--console"]
        if 비번.get() != ""
            인자 = 인자 + ["--lock", 비번.get()]
            if 실행시물음.get() == 1
                인자 = 인자 + ["--ask-password"]
        top.destroy()
        콘솔지우기()
        로그("EXE 빌드 시작… (POI 전용 패키저 · Python 설치 불필요)")
        S.running = true
        W.run_btn.config(text: "■  빌드 중", bg: "#e03131", fg: "#ffffff")
        _build_exe_bg(인자, 현재폴더())
        W.root.after(60, 펌프)

    tk.Button(top, text: "빌드 시작", command: 시작, bg: T.blue, fg: "#ffffff",
              relief: "flat", font: ui, padx: 16, pady: 7, cursor: "hand2").pack(anchor: "e", padx: 14, pady: 12)
    이름칸.focus_set()

fn 난독화보기()
    if S.file == null or S.dirty
        저장()
    if S.file == null
        return
    콘솔지우기()
    로그("🌫  난독화 미리보기 (이 파일을 exe 로 만들 때 들어갈 형태)")
    로그("────────────────────────────────────────")
    _obf_preview_bg(S.file)
    S.running = true
    W.root.after(60, 펌프)

fn 디컴파일()
    경로 = fd.askopenfilename(title: "검사·복구할 exe", filetypes: [["실행파일", "*.exe"], ["모든 파일", "*.*"]])
    if not 경로
        return
    콘솔지우기()
    로그("🔎  " + path.base(경로) + " 검사·복구 중…")
    로그("────────────────────────────────────────")
    _decompile_bg(경로)
    S.running = true
    W.root.after(60, 펌프)

fn 웹폴더()
    폴더 = fd.askdirectory(title: "웹으로 열 폴더")
    if not 폴더
        return
    진입 = _web_entry(폴더)
    if 진입
        파일열기(진입)
        로그("폴더의 서버 파일을 찾았어요:  {진입}")
        실행()
    else
        본문설정("# " + 폴더 + " 를 정적 서버로\nserver {\n    static \"" + 폴더 + "\"\n}\n")
        S.file = null
        제목갱신()
        로그("정적 서버로 폴더를 엽니다.")
        실행()

fn 편집됨(e)
    if W.editor.edit_modified()
        S.dirty = true
        제목갱신()
        _highlight(W.editor)
        W.editor.edit_modified(false)
        모드표시()

fn 커서이동(e)
    try
        W.editor.tag_remove("curline", "1.0", "end")
        W.editor.tag_add("curline", "insert linestart", "insert lineend+1c")
    catch e2
        pass
    상태갱신()

fn 예제넣기()
    본문설정(SAMPLE)
    S.dirty = false
    제목갱신()

# ── 하온 — 채팅창 ──────────────────────────────────────────────────
S.haon_open = false
S.haon_thinking = false
S.haon_attach = true
S.haon_history = []

fn 하온말풍선(태그, 글)
    W.haon_log.config(state: "normal")
    W.haon_log.insert("end", 글 + "\n\n", 태그)
    W.haon_log.see("end")
    W.haon_log.config(state: "disabled")

fn 하온시스템(글)
    하온말풍선("sys", 글)

fn 하온생각시작()
    W.haon_log.config(state: "normal")
    W.haon_log.mark_set("think_at", "end-1c")
    W.haon_log.mark_gravity("think_at", "left")
    W.haon_log.insert("end", "하온이 생각 중…\n\n", "think")
    W.haon_log.see("end")
    W.haon_log.config(state: "disabled")
    S.haon_thinking = true

fn 하온답(글)
    W.haon_log.config(state: "normal")
    if S.haon_thinking
        try
            W.haon_log.delete("think_at", "end")
        catch e
            pass
        S.haon_thinking = false
    W.haon_log.insert("end", "하온  " + 글 + "\n\n", "bot")
    W.haon_log.see("end")
    W.haon_log.config(state: "disabled")

fn 하온토글()
    if S.haon_open
        W.haon_frame.pack_forget()
        S.haon_open = false
    else
        W.haon_frame.pack(side: "right", fill: "y")
        S.haon_open = true
        W.haon_in.focus_set()
        if _haon_login(false)
            하온시스템("ChatGPT 로그인이 필요해요. 브라우저 로그인 창을 열었습니다.")

fn 하온로그인()
    if not S.haon_open
        하온토글()
    if not _haon_login(true)
        if _haon_gpt and _haon_gpt.status().get("logged_in") and not _haon_gpt.status().get("expired")
            하온시스템("ChatGPT에 이미 로그인되어 있어요.")
        else if _HAON_LOGIN["busy"]
            하온시스템("ChatGPT 로그인을 기다리고 있어요.")

fn 하온맥락()
    최근 = S.haon_history
    시작 = 0
    if len(최근) > 6
        시작 = len(최근) - 6
    줄들 = []
    for i in 시작..<len(최근)
        줄들 = 줄들 + [최근[i][0] + ": " + 최근[i][1]]
    if not 줄들
        return ""
    return "지금까지 나눈 대화:\n" + "\n".join(줄들) + "\n\n이어서 이번 질문에 답해줘:\n"

fn 하온첨부토글()
    if S.haon_attach
        S.haon_attach = false
        W.haon_attach_btn.config(text: "＋ 코드 첨부: 끔", fg: T.ink3)
    else
        S.haon_attach = true
        W.haon_attach_btn.config(text: "✓ 코드 첨부: 켬", fg: T.blue)

fn 하온묻기()
    원본 = W.haon_in.get("1.0", "end-1c")
    q = 원본.strip()
    if not q
        return
    W.haon_in.delete("1.0", "end")
    하온말풍선("me", "나  " + q)
    S.haon_history = S.haon_history + [["나", q]]
    첨부 = ""
    if S.haon_attach
        첨부 = 본문()
    하온생각시작()
    _haon_ask(하온맥락() + q, 첨부)

fn 하온보내기키(e)
    하온묻기()
    return "break"

fn 하온고치기()
    if not S.haon_open
        하온토글()
    하온시스템("이 파일을 실제 컴파일러로 검사하고 고치는 중…")
    S.haon_thinking = false
    _haon_autofix(본문())

fn 하온펌프()
    for 항목 in _haon_drain()
        갈래 = 항목[0]
        if 갈래 == "say"
            하온답(항목[1])
            S.haon_history = S.haon_history + [["하온", 항목[1]]]
        else if 갈래 == "badge"
            W.haon_sub.config(text: _haon_badge())
            하온답("이제 로컬 LLM 으로 답합니다.")
        else if 갈래 == "auth-log"
            하온시스템(항목[1])
        else if 갈래 == "auth-done"
            W.haon_sub.config(text: _haon_badge())
            if 항목[1]
                하온시스템("ChatGPT 로그인 완료. 이제 하온이 GPT로 답합니다.")
            else
                하온시스템("ChatGPT 로그인을 완료하지 못했어요. 'GPT 로그인'으로 다시 시도할 수 있어요.")
        else if 갈래 == "fix"
            본문설정(항목[1])
            S.dirty = true
            제목갱신()
            하온답("고쳤어요.\n" + 항목[2])
    W.root.after(120, 하온펌프)

fn 하온설치()
    if not S.haon_open
        하온토글()
    하온시스템("로컬 LLM 을 자동으로 설치·실행할게요. (Ollama + 작은 코더 모델, 1~2GB)")
    _haon_install()

fn 하온지우기()
    W.haon_log.config(state: "normal")
    W.haon_log.delete("1.0", "end")
    W.haon_log.config(state: "disabled")
    S.haon_history = []
    S.haon_thinking = false
    하온시스템("무엇이든 물어보세요. 오류는 '오류 자동수정' 이 실제 컴파일러로 고칩니다.")

# ── 명령 팔레트 (Ctrl+Shift+P) ─────────────────────────────────────
fn 팔레트()
    항목 = [
        ["새 파일", 새파일], ["열기…", 열기], ["최근 파일", 최근],
        ["저장", 저장], ["다른 이름으로 저장", 다른이름저장],
        ["실행 / 중지 / 서버 (F5)", 실행], ["콘솔 비우기", 콘솔지우기],
        ["터미널에서 실행", 터미널실행], ["웹 폴더 열기", 웹폴더],
        ["EXE 로 빌드 (이름·작자·난독화·비번)", EXE빌드],
        ["난독화 미리보기", 난독화보기],
        ["EXE 검사·복구", 디컴파일],
        ["예제 코드 넣기", 예제넣기],
        ["하온 채팅 열기 / 닫기", 하온토글],
        ["하온: 이 파일 오류 자동수정", 하온고치기],
        ["하온: 대화 지우기", 하온지우기],
        ["하온: 로컬 LLM 설치·실행", 하온설치],
        ["라이트 / 다크 테마 토글", 테마토글],
        ["글자 크게", () => W.editor.event_generate("<Control-equal>")],
        ["글자 작게", () => W.editor.event_generate("<Control-minus>")],
        ["POI 문법 문서 (웹)", () => 웹열기("https://hagora.kr/poi/poi-for-llm.md")],
        ["POI 입문서 (웹)", () => 웹열기("https://hagora.kr/poi/book/")]
    ]
    상태 = { items: 항목 }
    top = tk.Toplevel(W.root)
    top.title("명령 팔레트")
    top.configure(bg: T.bg2)
    top.geometry("480x360")
    top.transient(W.root)
    ent = tk.Entry(top, font: ui, relief: "flat", bg: T.bg, fg: T.ink,
                   insertbackground: T.blue)
    ent.pack(side: "top", fill: "x", padx: 12, pady: 12, ipady: 7)
    lb = tk.Listbox(top, font: ui, relief: "flat", bg: T.bg, fg: T.ink,
                    selectbackground: T.blue, selectforeground: "#ffffff",
                    activestyle: "none", highlightthickness: 0, borderwidth: 0)
    lb.pack(side: "top", fill: "both", expand: true, padx: 12, pady: 8)

    fn 채우기(질의)
        lb.delete(0, "end")
        걸림 = []
        낮은질의 = 질의.lower()
        for a in 항목
            if 질의 == "" or a[0].lower().find(낮은질의) >= 0
                걸림 = 걸림 + [a]
                lb.insert("end", "   " + a[0])
        상태.items = 걸림
        if lb.size() > 0
            lb.selection_set(0)

    fn 실행선택()
        골라 = lb.curselection()
        후보 = 상태.items
        idx = 0
        if len(골라) > 0
            idx = 골라[0]
        if idx < len(후보)
            top.destroy()
            후보[idx][1]()

    채우기("")
    ent.bind("<KeyRelease>", (e) => 채우기(ent.get()))
    ent.bind("<Return>", (e) => 실행선택())
    ent.bind("<Escape>", (e) => top.destroy())
    ent.bind("<Down>", (e) => lb.focus_set())
    lb.bind("<Return>", (e) => 실행선택())
    lb.bind("<Double-Button-1>", (e) => 실행선택())
    lb.bind("<Escape>", (e) => top.destroy())
    ent.focus_set()

# ── 상태줄 ─────────────────────────────────────────────────────────
fn 하온짧은상태()
    m = _HAON.get("mode")
    if m == "groq"
        return "Groq"
    if m == "ollama"
        return "로컬 LLM"
    if m == "none"
        return "없음"
    return "규칙"

fn 상태갱신()
    자리 = W.editor.index("insert").split(".")
    글 = 본문()
    모드 = "일반"
    if S.serving
        모드 = "● 서버 실행 중"
    else if _has_web(글)
        모드 = "웹 서버"
    else if _has_gui(글)
        모드 = "GUI 앱"
    W.status.config(text: "  {자리[0]}:{자리[1]}      {모드}      하온 {하온짧은상태()}      POI {버전}      Ctrl+Shift+P 명령 팔레트")

# 부팅 스플래시 — 문어 로고가 콘솔에 쫘라락 (파란색)
S.splash = 0
fn 스플래시줄(줄)
    W.out.config(state: "normal")
    W.out.insert("end", "  " + 줄 + "\n", "octo")
    W.out.see("end")
    W.out.config(state: "disabled")

fn 스플래시()
    if S.splash >= len(OCTO)
        로그("")
        로그("POI IDLE   ·   POI {버전}   —   F5 로 실행")
        로그("────────────────────────────────────────")
        return
    스플래시줄(OCTO[S.splash])
    S.splash = S.splash + 1
    W.root.after(16, 스플래시)

# ── 테마 ────────────────────────────────────────────────────────────
설정 = _cfg_load()
S.theme = "light"
if 설정.get("theme") == "dark"
    S.theme = "dark"
T = boxify(THEMES[S.theme])

fn 테마적용()
    T2 = boxify(THEMES[S.theme])
    W.root.configure(bg: T2.bg)
    W.bar.configure(bg: T2.bg2)
    W.mid.configure(bg: T2.bg)
    W.editor.configure(bg: T2.bg, fg: T2.ink, insertbackground: T2.blue, selectbackground: T2.sel)
    W.gutter.configure(bg: T2.bg2, fg: T2.gutter)
    W.console.configure(bg: T2.console)
    W.out_label.configure(bg: T2.console, fg: T2.ink3)
    W.out.configure(bg: T2.console, fg: T2.consink)
    W.out.tag_configure("octo", foreground: T2.octo)
    W.status.configure(bg: T2.bg2, fg: T2.ink2)
    W.editor.tag_configure("kw", foreground: T2.kw)
    W.editor.tag_configure("str", foreground: T2.str)
    W.editor.tag_configure("com", foreground: T2.com)
    W.editor.tag_configure("num", foreground: T2.num)
    W.editor.tag_configure("fn", foreground: T2.fn)
    W.editor.tag_configure("curline", background: T2.bg2)
    W.mid.configure(bg: T2.bg)
    try
        W.haon_frame.configure(bg: T2.bg2)
        W.haon_top.configure(bg: T2.bg2)
        W.haon_head.configure(bg: T2.bg2, fg: T2.ink)
        W.haon_clear.configure(bg: T2.bg2, fg: T2.ink3)
        W.haon_sub.configure(bg: T2.bg2, fg: T2.ink3, text: _haon_badge())
        W.haon_log.configure(bg: T2.bg, fg: T2.ink)
        W.haon_log.tag_configure("me", foreground: T2.blue)
        W.haon_log.tag_configure("bot", foreground: T2.ink)
        W.haon_log.tag_configure("sys", foreground: T2.ink3)
        W.haon_log.tag_configure("think", foreground: T2.ink3)
        W.haon_actions.configure(bg: T2.bg2)
        W.haon_attach_btn.configure(bg: T2.bg2)
        W.haon_fix.configure(bg: T2.bg2, fg: T2.ink2)
        W.haon_llm.configure(bg: T2.bg2, fg: T2.ink2)
        W.haon_inwrap.configure(bg: T2.bg)
        W.haon_in.configure(bg: T2.bg, fg: T2.ink, insertbackground: T2.blue)
        W.haon_send.configure(bg: T2.blue)
        for s in W.seps
            s.configure(bg: T2.line)
    catch e
        pass
    for b in W.buttons
        스킨(b, false)
    스킨(W.run_btn, true)
    상태갱신()
    설정["theme"] = S.theme
    _cfg_save(설정)

fn 테마토글()
    if S.theme == "light"
        S.theme = "dark"
    else
        S.theme = "light"
    테마적용()

fn 스킨(b, 강조)
    cur = boxify(THEMES[S.theme])
    if 강조
        b.configure(bg: cur.blue, fg: "#ffffff", activebackground: cur.blue, activeforeground: "#ffffff")
    else
        b.configure(bg: cur.bg2, fg: cur.ink2, activebackground: cur.line, activeforeground: cur.ink)

# ── 창 만들기 ───────────────────────────────────────────────────────
W.root = tk.Tk()
W.root.title("POI IDLE")
W.root.geometry("1080x720")
W.root.minsize(820, 560)
W.root.configure(bg: T.bg)
W.buttons = []

글꼴 = tkfont.Font(family: "Consolas", size: 12)
ui = tkfont.Font(family: "Segoe UI", size: 10)

fn 버튼(부모, 라벨, 동작, 강조)
    b = tk.Button(부모, text: 라벨, command: 동작, relief: "flat",
                  font: ui, padx: 12, pady: 6, borderwidth: 0, cursor: "hand2")
    스킨(b, 강조)
    b.pack(side: "left", padx: 4, pady: 7)
    W.buttons.add(b)
    return b

# 메뉴바
W.menu = tk.Menu(W.root)
W.m_file = tk.Menu(W.menu, tearoff: false)
W.m_file.add_command(label: "새 파일        Ctrl+N", command: 새파일)
W.m_file.add_command(label: "열기…          Ctrl+O", command: 열기)
W.m_file.add_command(label: "최근 파일", command: 최근)
W.m_file.add_separator()
W.m_file.add_command(label: "저장            Ctrl+S", command: 저장)
W.m_file.add_command(label: "다른 이름으로   Ctrl+Shift+S", command: 다른이름저장)
W.m_file.add_separator()
W.m_file.add_command(label: "터미널에서 실행  Ctrl+R", command: 터미널실행)
W.m_file.add_command(label: "끝내기", command: () => W.root.destroy())
W.menu.add_cascade(label: "파일", menu: W.m_file)

W.m_edit = tk.Menu(W.menu, tearoff: false)
W.m_edit.add_command(label: "실행 취소  Ctrl+Z", command: () => W.editor.edit_undo())
W.m_edit.add_command(label: "다시 실행  Ctrl+Y", command: () => W.editor.edit_redo())
W.m_edit.add_separator()
W.m_edit.add_command(label: "주석 토글  Ctrl+/", command: () => W.editor.event_generate("<Control-slash>"))
W.m_edit.add_command(label: "찾기        Ctrl+F", command: () => W.editor.event_generate("<Control-f>"))
W.menu.add_cascade(label: "편집", menu: W.m_edit)

W.m_run = tk.Menu(W.menu, tearoff: false)
W.m_run.add_command(label: "실행 / 중지 / 서버   F5", command: 실행)
W.m_run.add_command(label: "콘솔 비우기", command: 콘솔지우기)
W.menu.add_cascade(label: "실행", menu: W.m_run)

W.m_view = tk.Menu(W.menu, tearoff: false)
W.m_view.add_command(label: "라이트 / 다크 토글", command: 테마토글)
W.m_view.add_command(label: "글자 크게  Ctrl+=", command: () => W.editor.event_generate("<Control-equal>"))
W.m_view.add_command(label: "글자 작게  Ctrl+-", command: () => W.editor.event_generate("<Control-minus>"))
W.menu.add_cascade(label: "보기", menu: W.m_view)

W.m_help = tk.Menu(W.menu, tearoff: false)
W.m_help.add_command(label: "POI 문법 (웹)", command: () => 웹열기("https://hagora.kr/poi/poi-for-llm.md"))
W.m_help.add_command(label: "POI 입문서 (웹)", command: () => 웹열기("https://hagora.kr/poi/book/"))
W.menu.add_cascade(label: "도움말", menu: W.m_help)
W.root.config(menu: W.menu)

fn 웹열기(주소)
    try
        use py:webbrowser as _wb
        _wb.open(주소)
    catch e
        로그("{e}")

# 툴바 — 그룹별로 얇은 구분선
W.bar = tk.Frame(W.root, bg: T.bg2)
W.bar.pack(side: "top", fill: "x")
W.seps = []

fn 구분선()
    s = tk.Frame(W.bar, bg: T.line, width: 1)
    s.pack(side: "left", fill: "y", padx: 6, pady: 8)
    W.seps.add(s)

버튼(W.bar, "＋ 새로", 새파일, false)
버튼(W.bar, "📂 열기", 열기, false)
버튼(W.bar, "🕘 최근", 최근, false)
버튼(W.bar, "💾 저장", 저장, false)
구분선()
W.run_btn = 버튼(W.bar, "▶  실행  (F5)", 실행, true)
