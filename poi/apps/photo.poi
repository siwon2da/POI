# ┌─────────────────────────────────────────────────────────────────┐
# │  POI 사진 편집기  —  POI 로 작성 (uikit + Pillow)               │
# │  실행:  poi photo [사진.jpg]      빌드:  poi build --app photo  │
# └─────────────────────────────────────────────────────────────────┘

use py:tkinter as tk

python {
    import os
    try:
        from PIL import Image, ImageTk, ImageEnhance, ImageFilter, ImageOps
        _PIL_OK = True
    except Exception:
        _PIL_OK = False

    _FILTERS = {
        "흑백":   lambda im: ImageOps.grayscale(im).convert("RGB"),
        "세피아": lambda im: _sepia(im),
        "반전":   lambda im: ImageOps.invert(im.convert("RGB")),
        "블러":   lambda im: im.filter(ImageFilter.GaussianBlur(2.5)),
        "샤픈":   lambda im: im.filter(ImageFilter.SHARPEN),
        "윤곽":   lambda im: im.filter(ImageFilter.CONTOUR),
        "자동보정": lambda im: ImageOps.autocontrast(im.convert("RGB"), 2),
    }

    def _sepia(im):
        g = ImageOps.grayscale(im)
        return ImageOps.colorize(g, "#2b1c0f", "#fff1d6").convert("RGB")

    def _open_image(path):
        im = Image.open(path)
        return im.convert("RGB")

    def _recompute(S):
        """원본 + 슬라이더 값으로 현재 이미지를 다시 만든다."""
        im = S["orig"]
        if im is None:
            return
        for op in S.get("ops", []):
            im = op(im)
        im = ImageEnhance.Brightness(im).enhance(S["bright"])
        im = ImageEnhance.Contrast(im).enhance(S["contrast"])
        im = ImageEnhance.Color(im).enhance(S["sat"])
        im = ImageEnhance.Sharpness(im).enhance(S["sharp"])
        S["img"] = im

    def _fit(im, w, h):
        iw, ih = im.size
        r = min(w / iw, h / ih, 1.0)
        if r < 1.0:
            im = im.resize((max(1, int(iw * r)), max(1, int(ih * r))),
                           Image.LANCZOS)
        return im

    def _render(cv, S):
        cv.delete("all")
        im = S.get("img")
        if im is None:
            cv.create_text(cv.winfo_width() // 2 or 380,
                           cv.winfo_height() // 2 or 240,
                           text="열기 로 사진을 불러오세요", fill="#8b95a1",
                           font=("Segoe UI", 13))
            return
        w = cv.winfo_width() or 760
        h = cv.winfo_height() or 460
        shown = _fit(im, w - 20, h - 20)
        S["_tkimg"] = ImageTk.PhotoImage(shown)
        cv.create_image(w // 2, h // 2, image=S["_tkimg"])

    def _push_history(S):
        S.setdefault("undo", []).append(dict(
            ops=list(S.get("ops", [])),
            bright=S["bright"], contrast=S["contrast"],
            sat=S["sat"], sharp=S["sharp"]))
        S["undo"] = S["undo"][-30:]
        S["redo"] = []

    def _restore(S, snap):
        S["ops"] = list(snap["ops"])
        S["bright"], S["contrast"] = snap["bright"], snap["contrast"]
        S["sat"], S["sharp"] = snap["sat"], snap["sharp"]

    def _save(S, path):
        im = S.get("img")
        if im is None:
            return False
        ext = (os.path.splitext(path)[1] or ".png").lower()
        if ext in (".jpg", ".jpeg"):
            im.save(path, quality=92)
        else:
            im.save(path)
        return True

    def _startpath():
        p = os.environ.get("POI_PHOTO_OPEN", "")
        return p if p and os.path.isfile(p) else ""
}

S = { orig: null, img: null, path: null, bright: 1.0, contrast: 1.0, sat: 1.0, sharp: 1.0, ops: [] }
W = {}

fn 다시그리기()
    _render(W.cv, S)
    이름 = "새 사진"
    if S.path != null
        이름 = path.base(S.path)
    W.win.title("POI 사진 편집기  —  {이름}")

fn 재계산()
    _recompute(S)
    다시그리기()

fn 파일열기(경로)
    try
        S.orig = _open_image(경로)
        S.ops = []
        S.bright = 1.0
        S.contrast = 1.0
        S.sat = 1.0
        S.sharp = 1.0
        S.path = 경로
        재계산()
        상태("열었어요:  {경로}   ({S.orig.size[0]}×{S.orig.size[1]})")
    catch e
        uikit.alert("열 수 없어요: {e}")

fn 열기()
    p = uikit.ask_open("사진 열기", [["이미지", "*.png *.jpg *.jpeg *.gif *.bmp *.webp"], ["모든 파일", "*.*"]])
    if p
        파일열기(p)

fn 저장()
    if S.img == null
        return
    기본 = ".png"
    if S.path != null
        기본 = path.ext(S.path)
    p = uikit.ask_save("사진 저장", 기본, [["PNG", "*.png"], ["JPEG", "*.jpg"], ["모든 파일", "*.*"]])
    if p and _save(S, p)
        상태("저장했어요:  {p}")

fn 슬라이더변경(무엇, 값)
    S[무엇] = 값
    재계산()

fn 슬라이더놓음()
    _push_history(S)

fn 필터적용(이름)
    _push_history(S)
    S.ops.add(_FILTERS[이름])
    재계산()
    상태("필터:  {이름}")

fn 회전(각도)
    _push_history(S)
    S.orig = S.orig.rotate(-각도, expand: true)
    재계산()

fn 뒤집기(축)
    _push_history(S)
    if 축 == "h"
        S.orig = S.orig.transpose(0)
    else
        S.orig = S.orig.transpose(1)
    재계산()

fn 되돌리기()
    목록 = S.undo
    if not 목록
        상태("되돌릴 게 없어요.")
        return
    스냅 = 목록.pop()
    S.redo.add({ ops: S.ops, bright: S.bright, contrast: S.contrast, sat: S.sat, sharp: S.sharp })
    _restore(S, 스냅)
    슬라이더동기화()
    재계산()

fn 다시()
    목록 = S.redo
    if not 목록
        return
    스냅 = 목록.pop()
    _restore(S, 스냅)
    슬라이더동기화()
    재계산()

fn 리셋()
    _push_history(S)
    S.ops = []
    S.bright = 1.0
    S.contrast = 1.0
    S.sat = 1.0
    S.sharp = 1.0
    슬라이더동기화()
    재계산()

fn 슬라이더동기화()
    W.s_bright._poi_var.set(S.bright)
    W.s_contrast._poi_var.set(S.contrast)
    W.s_sat._poi_var.set(S.sat)
    W.s_sharp._poi_var.set(S.sharp)

fn 상태(글)
    uikit.set_text(W.status, "  " + 글)

# ── 화면 ────────────────────────────────────────────────────────────
if not _PIL_OK
    r = tk.Tk()
    r.title("POI 사진 편집기")
    tk.Label(r, text: "Pillow 가 필요해요.\n\n터미널에서:   poi add pillow\n\n설치 후 다시 poi photo", font: "Segoe UI 12", padx: 40, pady: 40).pack()
    r.mainloop()
else
    W.win = uikit.window("POI 사진 편집기", 1040, 680)

    uikit.menu(W.win, {
        파일: [["열기…", 열기], ["저장…", 저장], null, ["끝내기", () => uikit.close(W.win)]],
        편집: [["되돌리기", 되돌리기], ["다시", 다시], ["원본으로", 리셋]]
    })

    W.bar = uikit.row(W.win)
    uikit.button(W.bar, "📂 열기", 열기, false)
    uikit.button(W.bar, "💾 저장", 저장, true)
    uikit.button(W.bar, "↶ 되돌리기", 되돌리기, false)
    uikit.button(W.bar, "↷ 다시", 다시, false)
    uikit.button(W.bar, "⟳ 90°", () => 회전(90), false)
    uikit.button(W.bar, "⇋ 좌우", () => 뒤집기("h"), false)
    uikit.button(W.bar, "⇅ 상하", () => 뒤집기("v"), false)
    uikit.button(W.bar, "♻ 원본", 리셋, false)

    W.body = uikit.row(W.win)
    W.cv = uikit.canvas(W.body, 740, 520)

    W.panel = uikit.column(W.body, 8, "right")
    uikit.label(W.panel, "보정", 11)
    W.s_bright   = uikit.slider(W.panel, 0.2, 2.0, (v) => 슬라이더변경("bright", v), 1.0, 200, "밝기")
    W.s_contrast = uikit.slider(W.panel, 0.2, 2.0, (v) => 슬라이더변경("contrast", v), 1.0, 200, "대비")
    W.s_sat      = uikit.slider(W.panel, 0.0, 2.0, (v) => 슬라이더변경("sat", v), 1.0, 200, "채도")
    W.s_sharp    = uikit.slider(W.panel, 0.0, 3.0, (v) => 슬라이더변경("sharp", v), 1.0, 200, "선명")
    uikit.on(W.s_bright, "<ButtonRelease-1>", 슬라이더놓음)
    uikit.on(W.s_contrast, "<ButtonRelease-1>", 슬라이더놓음)
    uikit.on(W.s_sat, "<ButtonRelease-1>", 슬라이더놓음)
    uikit.on(W.s_sharp, "<ButtonRelease-1>", 슬라이더놓음)

    uikit.label(W.panel, "필터", 11)
    W.f1 = uikit.row(W.panel)
    uikit.button(W.f1, "흑백", () => 필터적용("흑백"), false)
    uikit.button(W.f1, "세피아", () => 필터적용("세피아"), false)
    uikit.button(W.f1, "반전", () => 필터적용("반전"), false)
    W.f2 = uikit.row(W.panel)
    uikit.button(W.f2, "블러", () => 필터적용("블러"), false)
    uikit.button(W.f2, "샤픈", () => 필터적용("샤픈"), false)
    uikit.button(W.f2, "윤곽", () => 필터적용("윤곽"), false)
    W.f3 = uikit.row(W.panel)
    uikit.button(W.f3, "자동 보정", () => 필터적용("자동보정"), true)

    W.status = uikit.statusbar(W.win, "  POI 사진 편집기 — 열기 로 시작")

    W.win.bind("<Control-o>", (e) => 열기())
    W.win.bind("<Control-s>", (e) => 저장())
    W.win.bind("<Control-z>", (e) => 되돌리기())
    W.win.bind("<Control-y>", (e) => 다시())
    W.win.bind("<Configure>", (e) => 다시그리기())

    시작 = _startpath()
    if 시작
        W.win.after(150, () => 파일열기(시작))

    uikit.run(W.win)
