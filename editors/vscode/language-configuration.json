{
  "comments": {
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "\"\"\"", "close": "\"\"\"" }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "(\\{[^}\"']*$)|(:\\s*$)|^\\s*(if|else if|elif|else|for|while|repeat|fn|def|try|catch|match|when|server|webapp|app|background|every)\\b.*[^}]\\s*$",
    "decreaseIndentPattern": "^\\s*(\\}|end|else|else if|elif|catch)\\b"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(fn|def|if|else if|elif|for|while|repeat|try|catch|match|when)\\b.*[^{};]\\s*$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "[^\\W\\d][\\w가-힣]*"
}
