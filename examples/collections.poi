# 배열 / 객체 / 문자열 편의 기능

nums = [3, 1, 4, 1, 5, 9, 2, 6]
show "길이: {nums.length}"
show "첫번째: {nums.first}, 마지막: {nums.last}"
show "정렬: {nums.reverse()}"

nums.add(10)
show "추가 후: {nums}"

name = "Poi Language"
show name.upper()
show name.lower()
show name.contains("Lang")
show name.words()

people = [
    { name: "시원", age: 16 },
    { name: "예성", age: 17 },
    { name: "민수", age: 15 }
]

total = 0
for p in people {
    show "{p.name} ({p.age})"
    total = total + p.age
}
show "평균 나이: {total / people.length}"
