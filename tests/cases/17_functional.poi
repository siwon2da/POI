nums = [5, -3, 8, 1, -7, 12]
show nums |> filter(x => x > 0) |> map(x => x * 2) |> sum_of
show [1, 2, 3, 4, 5] |> reduce((a, b) => a + b)
show (["a", "bb", "ccc"] |> sort_by(w => w.length) |> reverse_of).join("-")
show ([3, 1, 2, 1, 3] |> unique).length
show [1, 2, 3, 4, 5, 6] |> count_where(x => x % 2 is 0)
