# v1.12 — 동시성 (task · channel · background · every)
fn sq(x) => x * x
show task.all(sq, [1, 2, 3, 4])

fn work()
    task.sleep(0.02)
    return 42
show task.wait(task.run(work))

ch = task.channel()
fn feed()
    for i in 1..3
        ch.send(i)
    ch.close()
task.run(feed)
total = 0
for v in ch
    total = total + v
show total

box = { hits: 0 }
every 5 ms {
    box.hits = box.hits + 1
}
task.sleep(0.06)
show box.hits > 0

background {
    box.hits = box.hits + 1000
}
task.sleep(0.04)
show box.hits >= 1000

show ([3, 1, 2] |> sort_by(x => x) |> sum_of)
